# User Service Environment Variables

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/ecommerce?current_schema=public
DB_USERNAME=postgres
DB_PASSWORD=root

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=ecommerce
KEYCLOAK_CLIENT_ID=ecommerce-app
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/ecommerce/protocol/openid-connect/token
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/ecommerce

# Mail Configuration (Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=no-reply@ecommerce.local
MAIL_PASSWORD=
